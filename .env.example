# 后端模式：neon | rest（默认 neon）
VITE_BACKEND=neon

# 浏览器直连 Neon HTTP /sql 的连接串（角色 nav_read，RLS 过滤公开数据；会内联进构建产物，安全边界=RLS）
VITE_NEON_DATABASE_URL=postgresql://nav_read:xxx@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# EdgeOne Makers 同站函数路由（edge-functions/api/**）; 默认相对路径同域调用, 如需自定义域名再覆盖
VITE_API_BASE_URL=/api

# 注意：
# - nav_admin 连接串与 JWT_SECRET 不写在此文件，配置在 EdgeOne Makers 控制台项目环境变量
#   （DATABASE_URL_ADMIN / JWT_SECRET，函数经 context.env 读取）
# - 以下仅函数读取的变量同样在 Makers 控制台配置（不进前端 bundle）；不配则用默认值

# 只读快照缓存（边缘函数 GET /api/frontend-data）
# SNAPSHOT_STORE_NAME=nav-snapshot        # Blob 命名空间，首次调用自动创建
# SNAPSHOT_TTL_SECONDS=600                # 快照新鲜期（秒），期内零回源 Neon
# SNAPSHOT_SWR_SECONDS=300                # stale-while-revalidate 窗口（秒）
# SNAPSHOT_BROWSER_MAX_AGE=60             # 浏览器 Cache-Control max-age（秒）
# SNAPSHOT_READ_CONSISTENCY=eventual      # Blob 读一致性：eventual|strong
# SNAPSHOT_ALERT_WEBHOOK=                 # 可选：重建失败/降级错误上报 URL

# 点击统计缓冲（边缘函数 POST /api/stats/click，批量/延迟写入）
# CLICK_BATCH_SIZE=20                     # 条数阈值，达阈值批量落库一次
# CLICK_MAX_AGE_SECONDS=10                # 时间阈值（距首条缓冲），防尾批滞留